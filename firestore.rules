rules_version = '2';

// Firestore security rules of the "Spending Monitor" project.
// Published in the Firebase console (Firestore -> Rules); keep this file in sync.
//
// Any Google account may sign in; each user sees only their own organisations
// and contracts on control:
//   users/{uid}                 profile, read and written only by its owner
//     /myorgs/{edrpou}          organisations the user follows (role: buyer|supplier)
//     /tracked/{contractId}     contracts the user has on control (Prozorro contract
//                               id), with the user's own note and whom it is shared with
//     /shared/{contractId}      contracts other users shared with this user: written
//                               by the sharer (who must have it on control), read and
//                               removed by the recipient; the sharer may withdraw it
//   emails/{email}              e-mail -> uid of a registered user, so a contract can
//                               be shared by e-mail; single reads only, no listing
//   pub/{hash}                  what GitHub Actions has to sync: organisation codes and
//                               contract ids under sha256("monitor:" + uid), no names,
//                               e-mails or uids; public read, written only by its owner
//   analysts/{uid}              verified analysts (added in the console only): may update
//                               shared reviews and organisation uploads of others
//   reviews/{id}                status of a signal or contract check
//   reviews/{id}/history/{e}    append-only audit trail of those checks
//   exports/{id}                append-only log of uploads to Google Drive
//   companies/{edrpou}          cached company cards
//   orgs/{edrpou}               uploaded company documents: the card itself,
//     /{collection}/{id}        contracts, acts, addendums, penalties, payments,
//                               liabilities, reports, signals
//     /meta/{collection}        fingerprints of uploaded records (incremental upload)
//   watchlist/{edrpou}, tracked/{contractId}   before v0.10: closed; a legacy contract
//                               is read once by whoever picked it, to move it over
service cloud.firestore {
  match /databases/{database}/documents {
    // Only Google sign-in with a verified e-mail counts: other providers are not part of the app.
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function isAnalyst() {
      return signedIn() && exists(/databases/$(database)/documents/analysts/$(request.auth.uid));
    }
    // Who opened a shared record: createdBy, or the first editor of records made before it existed.
    function opener(data) {
      return data.get('createdBy', data.get('updatedBy', data.get('uploadedBy', '')));
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function myHash() {
      return hashing.sha256('monitor:' + request.auth.uid).toHexString().lower();
    }
    function str(v, n) {
      return v is string && v.size() <= n;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'lang', 'lastLogin', 'createdAt', 'driveScript']);
      allow delete: if false;

      match /myorgs/{edrpou} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid) && edrpou.matches('^([0-9]{8}|[0-9]{10})$')
          && request.resource.data.keys().hasOnly(['edrpou', 'name', 'role', 'note', 'addedAt'])
          && request.resource.data.edrpou == edrpou
          && request.resource.data.role in ['buyer', 'supplier']
          && str(request.resource.data.name, 300) && str(request.resource.data.note, 500);
      }

      match /tracked/{cid} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid) && cid.matches('^[0-9a-f]{32}$')
          && request.resource.data.keys().hasOnly(['org', 'tid', 'sp', 'title', 'number', 'buyer', 'supplier', 'note', 'addedAt', 'sharedWith'])
          && request.resource.data.org.matches('^[0-9]{8,10}$')
          && request.resource.data.tid.matches('^UA-[0-9A-Za-z-]{10,40}$')
          && str(request.resource.data.note, 500) && str(request.resource.data.title, 500)
          && (!('sharedWith' in request.resource.data) || (request.resource.data.sharedWith is list && request.resource.data.sharedWith.size() <= 50));
      }

      match /shared/{cid} {
        allow read: if isSelf(uid) || (signedIn() && resource.data.from == request.auth.uid);
        allow create, update: if signedIn() && request.auth.uid != uid && cid.matches('^[0-9a-f]{32}$')
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/tracked/$(cid))
          && (resource == null || resource.data.from == request.auth.uid)
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'org', 'tid', 'sp', 'title', 'number', 'buyer', 'supplier', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.tid.matches('^UA-[0-9A-Za-z-]{10,40}$')
          && str(request.resource.data.title, 500) && str(request.resource.data.fromName, 200)
          && request.resource.data.at == request.time;
        allow delete: if isSelf(uid) || (signedIn() && resource.data.from == request.auth.uid);
      }
    }

    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['uid', 'name'])
          && request.resource.data.uid == request.auth.uid && str(request.resource.data.name, 200)));
    }

    match /pub/{h} {
      allow read: if true;
      allow create, update: if signedIn() && h == myHash()
        && request.resource.data.keys().hasOnly(['orgs', 'tracked', 'shares', 'at'])
        && request.resource.data.orgs is list && request.resource.data.orgs.size() <= 300
        && request.resource.data.tracked is list && request.resource.data.tracked.size() <= 500
        && request.resource.data.shares is list && request.resource.data.shares.size() <= 1000
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && h == myHash();
    }

    // Before v0.10 lists were shared and public; now closed. Whoever picked a
    // contract may read it once and switch it off after moving it to their own list.
    match /watchlist/{edrpou} {
      allow read, write: if false;
    }
    match /tracked/{id} {
      allow read: if signedIn() && resource.data.addedBy == request.auth.uid;
      allow update: if signedIn() && resource.data.addedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedBy', 'updatedAt'])
        && request.resource.data.active == false;
      allow create, delete: if false;
    }

    match /analysts/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /reviews/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['org', 'contract', 'signalType', 'title', 'status', 'comment', 'updatedBy', 'updatedByName', 'updatedAt', 'createdBy'])
        && (resource == null
              ? request.resource.data.createdBy == request.auth.uid
              : (opener(resource.data) == request.auth.uid || isAnalyst()) && request.resource.data.createdBy == opener(resource.data))
        && request.resource.data.status in ['new', 'in_progress', 'resolved', 'false_positive']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 4000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /history/{entry} {
        allow read: if signedIn();
        // Written in one batch with the review: the review itself must be this user's write.
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/reviews/$(id)).data.updatedBy == request.auth.uid
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    match /exports/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /companies/{edrpou} {
      allow read: if signedIn();
      allow write: if signedIn() && edrpou.matches('^[0-9]{8,10}$');
    }

    match /orgs/{edrpou} {
      allow read: if signedIn();
      // The first uploader owns an organisation's upload; analysts may refresh anyone's.
      allow create, update: if signedIn() && edrpou.matches('^[0-9]{8,10}$')
        && request.resource.data.edrpou == edrpou
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.uploadedAt == request.time
        && (resource == null || resource.data.uploadedBy == request.auth.uid || isAnalyst());
      allow delete: if false;

      match /{collection}/{id} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && collection in ['contracts', 'acts', 'addendums', 'penalties', 'payments', 'liabilities', 'reports', 'signals', 'meta']
          && (get(/databases/$(database)/documents/orgs/$(edrpou)).data.uploadedBy == request.auth.uid || isAnalyst());
        allow delete: if false;
      }
    }
  }
}
