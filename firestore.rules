rules_version = '2';

// Firestore security rules of the "Spending Monitor" project.
// Published in the Firebase console (Firestore -> Rules); keep this file in sync.
//
// Any signed-in Google account may use the app. Analysts share one database:
//   users/{uid}                 profile, written only by its owner
//   reviews/{id}                status of a signal or contract check
//   reviews/{id}/history/{e}    append-only audit trail of those checks
//   exports/{id}                append-only log of uploads to Google Drive
//   companies/{edrpou}          cached company cards
//   orgs/{edrpou}               uploaded company documents: the card itself,
//     /{collection}/{id}        contracts, acts, addendums, penalties, payments,
//                               liabilities, reports, signals
//     /meta/{collection}        fingerprints of uploaded records (incremental upload)
//   watchlist/{edrpou}          organisations added from the app (role: buyer or
//                               supplier); public read so GitHub Actions can pick
//                               them up without credentials
//   tracked/{contractId}        contracts on control (Prozorro contract id); public
//                               read for GitHub Actions; switched off, never deleted
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'lang', 'lastLogin', 'createdAt']);
      allow delete: if false;
    }

    match /reviews/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['org', 'contract', 'signalType', 'title', 'status', 'comment', 'updatedBy', 'updatedByName', 'updatedAt'])
        && request.resource.data.status in ['new', 'in_progress', 'resolved', 'false_positive']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 4000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /history/{entry} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    match /exports/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /companies/{edrpou} {
      allow read: if signedIn();
      allow write: if signedIn() && edrpou.matches('^[0-9]{8,10}$');
    }

    match /watchlist/{edrpou} {
      allow read: if true;
      allow create, update: if signedIn() && edrpou.matches('^([0-9]{8}|[0-9]{10})$')
        && request.resource.data.keys().hasOnly(['edrpou', 'name', 'note', 'role', 'addedBy', 'addedAt'])
        && (!('role' in request.resource.data) || request.resource.data.role in ['buyer', 'supplier'])
        && request.resource.data.edrpou == edrpou
        && request.resource.data.name is string && request.resource.data.name.size() <= 300
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time;
      allow delete: if false;
    }

    match /tracked/{id} {
      allow read: if true;
      allow create: if signedIn() && id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['org', 'tid', 'sp', 'title', 'number', 'buyer', 'supplier', 'note', 'active', 'addedBy', 'addedByName', 'addedAt', 'updatedBy', 'updatedAt'])
        && request.resource.data.org is string && request.resource.data.org.matches('^[0-9]{8,10}$')
        && request.resource.data.tid is string && request.resource.data.tid.matches('^UA-[0-9A-Za-z-]{10,40}$')
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.title is string && request.resource.data.title.size() <= 500
        && request.resource.data.active is bool
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time;
      // Switching off or on, editing the note; who added it and when stay as they were.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'active', 'updatedBy', 'updatedAt'])
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.active is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /orgs/{edrpou} {
      allow read: if signedIn();
      allow create, update: if signedIn() && edrpou.matches('^[0-9]{8,10}$')
        && request.resource.data.edrpou == edrpou
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.uploadedAt == request.time;
      allow delete: if false;

      match /{collection}/{id} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && collection in ['contracts', 'acts', 'addendums', 'penalties', 'payments', 'liabilities', 'reports', 'signals', 'meta'];
        allow delete: if false;
      }
    }
  }
}
